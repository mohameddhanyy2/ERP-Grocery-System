<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.groceryerp</groupId>
    <artifactId>grocery-erp</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- WAR: deployed to a Jakarta EE 10 application server (WildFly 31+ / Payara 6+). -->
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>10.0.0</jakartaee.version>
    </properties>

    <dependencies>
        <!--
          Jakarta EE 10 full platform API — PROVIDED by the application server.
          This single dependency supplies: EJB (@Stateless/@Stateful/@MessageDriven),
          JPA (@Entity, EntityManager), CDI (@Inject), JMS, Servlet, and JAX-RS.
          scope=provided because WildFly/Payara already ship the implementations.
        -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          PostgreSQL JDBC driver (for Neon). Registered as a module/datasource in
          the app server (WildFly), so this is provided-scope — not bundled in the
          WAR. The Postgres dialect ships with Hibernate core, so no separate
          community-dialects dependency is needed (unlike SQLite).
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSON serialization for JAX-RS responses (JSON-B is provided; Jackson kept for parity). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>grocery-erp</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- No web.xml needed: JAX-RS + Servlet 6 use annotations. -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
